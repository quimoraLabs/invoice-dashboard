# Clerk Authentication Configuration
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxx

# Firebase Client SDK Configuration (Firestore & Storage)
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Groq AI API Key for server-side seed data generation (scripts/seed.js)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Serverless Backend & Admin Credentials (Vercel / Local)
# NOTE: Never expose CLERK_SECRET_KEY or FIREBASE_SERVICE_ACCOUNT with VITE_ prefix
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxx
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
APP_URL=http://localhost:5173

# Cloudinary Image Upload Configuration (Production Default)
VITE_CLOUDINARY_URL=https://api.cloudinary.com/v1_1/your_cloud_name/image/upload
VITE_CLOUDINARY_PRESET=your_unsigned_preset_name

# Media Storage Configuration (Local Emulator Alternative)
# Set VITE_USE_FLOCI=true locally to use Floci S3 emulator; keep false in Vercel production
VITE_USE_FLOCI=false
VITE_FLOCI_ENDPOINT=http://localhost:4566
VITE_FLOCI_ACCESS_KEY=test
VITE_FLOCI_SECRET_KEY=test
VITE_FLOCI_BUCKET=invoicing-media-local

# Optional Integration Environment Keys (Phase 3+)
# VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxx
# VITE_SENTRY_DSN=https://xxxxxx@sentry.io/xxxxxx

